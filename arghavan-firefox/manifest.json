{
  "manifest_version": 2,
  "name": "Arghavan",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "arghavan@dsam" } },
  "theme": {
    "colors": {
      "frame": "#121212",
      "frame_inactive": "#121212",
      "toolbar": "#1B1B1B",
      "toolbar_text": "#EDE3BA",
      "bookmark_text": "#EDE3BA",
      "icons": "#EDE3BA",
      "icons_attention": "#BE55E6",
      "toolbar_field": "#121212",
      "toolbar_field_text": "#EDE3BA",
      "toolbar_field_border": "#2B2B2B",
      "toolbar_field_focus": "#121212",
      "toolbar_field_text_focus": "#EDE3BA",
      "toolbar_field_border_focus": "#BE55E6",
      "toolbar_field_highlight": "#3A0F4D",
      "toolbar_field_highlight_text": "#EDE3BA",
      "toolbar_top_separator": "#2B2B2B",
      "toolbar_bottom_separator": "#2B2B2B",
      "toolbar_vertical_separator": "#2B2B2B",
      "tab_selected": "#1B1B1B",
      "tab_text": "#EDE3BA",
      "tab_background_text": "#8C867A",
      "tab_line": "#BE55E6",
      "tab_loading": "#BE55E6",
      "button_background_hover": "#2B2B2B",
      "button_background_active": "#3A0F4D",
      "popup": "#1B1B1B",
      "popup_text": "#EDE3BA",
      "popup_border": "#2B2B2B",
      "popup_highlight": "#3A0F4D",
      "popup_highlight_text": "#EDE3BA",
      "sidebar": "#121212",
      "sidebar_text": "#EDE3BA",
      "sidebar_border": "#2B2B2B",
      "sidebar_highlight": "#3A0F4D",
      "sidebar_highlight_text": "#EDE3BA",
      "ntp_background": "#121212",
      "ntp_text": "#EDE3BA"
    },
    "properties": { "color_scheme": "dark" }
  }
}
